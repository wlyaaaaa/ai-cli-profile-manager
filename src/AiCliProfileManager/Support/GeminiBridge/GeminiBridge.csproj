<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AiCli.GeminiResponsesBridge</AssemblyName>
    <RootNamespace>AiCli.GeminiBridge</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\data\gemini-models.json" LogicalName="AiCli.GeminiBridge.InitialModelSet.json" />
  </ItemGroup>
</Project>
