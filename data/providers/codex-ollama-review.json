{
  "schemaVersion": 1,
  "id": "codex-ollama-review",
  "displayName": "Codex CLI + local Qwen cross-check (35B)",
  "engine": "codex",
  "provider": "ollama",
  "plan": "local",
  "region": "local",
  "transport": "responses",
  "defaultEffort": "max",
  "effortLevels": ["low", "medium", "high", "max"],
  "endpoint": "http://127.0.0.1:32100/v1",
  "codexProviderId": "aicli_ollama_review",
  "codexModelCatalog": "qwen-main-v1-codex.json",
  "models": { "primary": "qwen-main-v1", "small": "qwen-main-v1", "candidates": ["qwen-main-v1"] },
  "modelMetadata": {
    "qwen-main-v1": { "contextWindowTokens": 262144, "outputWindowTokens": 8192 }
  },
  "compatibility": {
    "minCliVersion": "0.147.0",
    "localGpuBrokerSession": {
      "contractVersion": 1,
      "requiredForMachineRun": true,
      "managementOrigin": "http://127.0.0.1:32100"
    }
  },
  "auth": { "type": "none" },
  "capabilities": { "tools": true, "streaming": true, "images": false, "machineRun": true },
  "sources": ["https://docs.ollama.com/integrations/codex"],
  "requiresSecret": false,
  "virtualReady": true,
  "dataDestination": "LocalGpuBroker Ollama endpoint (127.0.0.1:32100)",
  "notes": "Independent local Qwen3.6 35B cross-check route. Machine runs require an owner-bound LocalGpuBroker session and never fall back to another model.",
  "flexible": false
}
