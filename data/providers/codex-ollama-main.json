{
  "schemaVersion": 1,
  "id": "codex-ollama-main",
  "displayName": "Codex CLI + local Qwen main",
  "engine": "codex",
  "provider": "ollama",
  "plan": "local",
  "region": "local",
  "transport": "responses",
  "defaultEffort": "max",
  "effortLevels": ["low", "medium", "high", "max"],
  "endpoint": "http://127.0.0.1:32100/v1",
  "codexProviderId": "aicli_ollama_main",
  "codexModelCatalog": "qwen-main-v1-codex.json",
  "models": { "primary": "qwen-main-v1", "small": "qwen-main-v1", "candidates": ["qwen-main-v1"] },
  "compatibility": { "minCliVersion": "0.144.0" },
  "auth": { "type": "none" },
  "capabilities": { "tools": true, "streaming": true, "images": true, "machineRun": true },
  "sources": ["https://docs.ollama.com/integrations/codex"],
  "requiresSecret": false,
  "virtualReady": true,
  "dataDestination": "LocalGpuBroker Ollama endpoint (127.0.0.1:32100)",
  "notes": "Machine run uses the native Codex workspace sandbox; the provider stays on the local broker with no cloud or fallback."
}
