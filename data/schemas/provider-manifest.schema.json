{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI CLI Profile Manager provider manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "displayName", "engine", "provider", "plan", "transport",
    "models", "auth", "capabilities", "sources", "requiresSecret", "virtualReady", "dataDestination"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "engine": { "enum": ["codex", "claude", "interpreter", "qwen-code", "opencode"] },
    "provider": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "plan": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "region": { "type": ["string", "null"] },
    "transport": { "enum": ["responses", "anthropic-messages", "managed-proxy", "openai-compatible"] },
    "wireApi": { "enum": ["responses", "chat"] },
    "endpoint": { "type": ["string", "null"] },
    "models": { "type": "object" },
    "modelMetadata": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contextWindowTokens"],
        "properties": {
          "contextWindowTokens": { "type": "integer", "minimum": 32768, "maximum": 4194304 },
          "autoCompactWindowTokens": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "inputWindowTokens": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "outputWindowTokens": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "compactionReserveTokens": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "preserveRecentTokens": { "type": "integer", "minimum": 1, "maximum": 4194304 },
          "tailTurns": { "type": "integer", "minimum": 1, "maximum": 256 }
        }
      }
    },
    "auth": { "type": "object" },
    "proxyRef": { "type": ["string", "null"] },
    "capabilities": { "type": "object" },
    "compatibility": { "type": "object" },
    "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "codexProviderId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "codexModelCatalog": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}\\.json$" },
    "codexAutoCompactTokenLimit": { "type": "integer", "minimum": 32768, "maximum": 4194304 },
    "codexAutoCompactTokenLimitScope": { "enum": ["total", "body_after_prefix"] },
    "interpreterProviderId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "requiresSecret": { "type": "boolean" },
    "virtualReady": { "type": "boolean" },
    "dataDestination": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"] },
    "hidden": { "type": "boolean" },
    "defaultEffort": { "type": ["string", "null"] },
    "effortLevels": { "type": "array", "items": { "type": "string" } },
    "effortMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" }
    },
    "flexible": { "type": "boolean" },
    "workspaceBaseUrlRequired": { "type": "boolean" },
    "autoRun": { "type": "boolean" },
    "modelPrefix": { "type": ["string", "null"] }
  }
}
